APP_ENV=development
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
# Format: username:password@tcp(host:port)/database?options
DATABASE_URL=cloud_drive:change-me@tcp(127.0.0.1:3306)/siato_drive?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci&loc=UTC
SESSION_COOKIE_NAME=cloud_drive_session
SESSION_TTL=24h
SESSION_SECURE=false
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=104857600
DEFAULT_ORGANIZATION_SLUG=default
SUPERADMIN_EMAIL=admin@example.test
SUPERADMIN_PASSWORD=change-this-development-password
